# API Configuration (uses same domain in production via Envoy Gateway)
VITE_API_BASE_PATH=/api

# Proxy routing
# Path the Digital Twins API requests are rewritten through.
# Default: /api/proxy (Konnektr Graph). Proxy-resolved deployments may differ.
VITE_TWINS_PROXY=/api/proxy

# Environments API endpoint (x-adt-id routing)
# Used by EnvironmentConnectionManager to fetch the environments the user can access.
VITE_ENVIRONMENTS_ENDPOINT=/api/environments
# Group label shown in the connection selector. Defaults to "Environments".
# VITE_ENVIRONMENTS_LABEL=Environments
# Optional overrides when the response uses non-standard field names.
# Auto-detected order: $dtId, id, environmentId, resource_id.
# VITE_ENVIRONMENTS_ID_FIELD=$dtId
# VITE_ENVIRONMENTS_NAME_FIELD=name

# Auth0 Configuration (for platform authentication)
VITE_AUTH0_DOMAIN=auth.konnektr.io
VITE_AUTH0_CLIENT_ID=ObWW1A2syc8tFeYkxTwnRvRdNgbuP9BE
VITE_AUTH0_KTRLPLANE_AUDIENCE=https://ktrlplane.konnektr.io
VITE_AUTH0_GRAPH_AUDIENCE=https://graph.konnektr.io
# Graph API scope - adjust based on your API's scope configuration
VITE_AUTH0_GRAPH_SCOPE=read:graph write:graph

# Azure AD B2C Configuration (for environment-based connections)
# Leave unset to disable environment-based connections entirely.
# VITE_B2C_SCOPE must be the platform API scope the proxy accepts — there is
# deliberately no default, and the manager no-ops when it is missing.
# VITE_B2C_CLIENT_ID=your-b2c-client-id
# VITE_B2C_AUTHORITY=https://your-tenant.b2clogin.com/your-tenant.onmicrosoft.com/your-policy
# VITE_B2C_KNOWN_AUTHORITY=your-tenant.b2clogin.com
# VITE_B2C_SCOPE=https://your-tenant.onmicrosoft.com/<api-client-id>/<Scope>

# Analytics
# Leave empty to omit the GTM plugin and suppress the cookie consent banner.
# VITE_GTM_ID=
