# API Configuration (uses same domain in production via Envoy Gateway)
VITE_API_BASE_PATH=/api

# Proxy routing
# When set, the custom pipeline policy rewrites API URLs through this path
# Default: /api/proxy (Konnektr Graph). Set to /api/digitaltwins for Arcadis.
VITE_TWINS_PROXY=/api/proxy

# Environments API endpoint
# Used by ArcadisConnectionManager to fetch available environments
VITE_ENVIRONMENTS_ENDPOINT=/api/environments

# Auth0 Configuration (for platform authentication)
VITE_AUTH0_DOMAIN=auth.konnektr.io
VITE_AUTH0_CLIENT_ID=ObWW1A2syc8tFeYkxTwnRvRdNgbuP9BE
VITE_AUTH0_KTRLPLANE_AUDIENCE=https://ktrlplane.konnektr.io
VITE_AUTH0_GRAPH_AUDIENCE=https://graph.konnektr.io
# Graph API scope - adjust based on your API's scope configuration
VITE_AUTH0_GRAPH_SCOPE=read:graph write:graph

# Azure B2C Configuration (for Arcadis environment-based connections)
# Override these with your B2C tenant details
# VITE_B2C_CLIENT_ID=your-b2c-client-id
# VITE_B2C_AUTHORITY=https://your-tenant.b2clogin.com/your-tenant.onmicrosoft.com/your-policy
# VITE_B2C_KNOWN_AUTHORITY=your-tenant.b2clogin.com
# VITE_B2C_SCOPE=https://your-tenant.onmicrosoft.com/api/.default
